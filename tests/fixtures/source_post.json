    "author": "class.author@text",
    "intro": "class.intro@text"
  },
  "ruleToc": {
    "chapterList": "class.module-row-text",
    "chapterName": "tag.a.0@text",
    "chapterUrl": "tag.a.0@href"
  },
  "ruleContent": {
    "content": "class.article-content.0@html##（本章完）"
  },
  "header": ""
